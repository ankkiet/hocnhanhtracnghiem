# =================================================================
# HOCNHANHTRACNGHIEM - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn
# =================================================================

# 1. CẤU HÌNH SERVER
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production

# 2. BẢO MẬT JWT & ADMIN
# Khóa bí mật dùng để mã hóa và xác thực JWT token (giáo viên, học sinh, admin)
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production

# 3. GOOGLE OAUTH 2.0 (Đăng nhập Google Sign-In)
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 4. FIREBASE ADMIN SDK (Firestore Database)
# Cách 1: Đặt file credentials tại thư mục gốc với tên: firebase-adminsdk.json
# Cách 2 (Khuyên dùng khi deploy Docker / Cloud VPS): Dán chuỗi JSON của Service Account vào biến dưới đây:
# FIREBASE_JSON={"type": "service_account", "project_id": "...", ...}

# 5. CLOUDFLARE R2 STORAGE (Lưu trữ ảnh đề thi tốc độ cao)
# Tùy chọn: Nếu để trống, hệ thống sẽ tự động lưu ảnh cục bộ vào thư mục uploads/images/
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://your-custom-domain-or-r2.dev

# 6. GOOGLE GEMINI AI (Trợ lý bóc tách và tạo đề AI)
# Khóa API Gemini lấy từ Google AI Studio (https://aistudio.google.com/)
# Hỗ trợ nhiều key cách nhau bằng dấu phẩy để hệ thống tự động luân phiên (Fallback / Rate Limit handling)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
